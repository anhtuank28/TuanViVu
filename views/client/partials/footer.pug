// Footer
footer.footer
  .container
    .footer__grid
      .footer__col
        .footer__logo
          a(href="/")
            img(alt="" src="/assets/images/logo.png")
        p.footer__desc Khám phá thế giới qua những chuyến đi tuyệt vời cùng TuanVivu. Chúng tôi mang đến những trải nghiệm du lịch đẳng cấp và an toàn.
        .footer__socials
          a(target="_blank" href="https://www.facebook.com/anh.tuan.246083?mibextid=wwXIfr&mibextid=wwXIfr")
            i.fa-brands.fa-facebook-f
          a(target="_blank" href="#")
            i.fa-brands.fa-instagram
          a(target="_blank" href="#")
            i.fa-brands.fa-twitter
          a(target="_blank" href="#")
            i.fa-brands.fa-youtube
      .footer__col
        h3.footer__title Về Chúng Tôi
        ul.footer__links
          li: a(href="#") Trang chủ
          li: a(href="#") Tour Trong Nước
          li: a(href="#") Tour Nước Ngoài
          li: a(href="#") Tin Tức
          li: a(href="#") Liên Hệ
      .footer__col
        h3.footer__title Thông tin
        ul.footer__links
          li: a(href="/privacy-policy") Điều khoản dịch vụ
          li: a(href="/terms-of-service") Chính sách bảo mật
          li: a(href="#") Hướng dẫn đặt tour
          li: a(href="#") Phương thức thanh toán
      .footer__col
        h3.footer__title Đăng Ký Nhận Tin
        p.footer__newsletter-desc Nhận thông báo về các ưu đãi tour mới nhất.
        form#email-form.footer__newsletter(action="#")
          input#email-input(name="email" placeholder="Nhập email của bạn..." type="email")
          button(type="submit")
            i.fa-solid.fa-paper-plane
    .footer__bottom
      p.footer__copyright © 2024 TuanVivu. All rights reserved.
// End Footer