extends ../layouts/default.pug
include ../mixins/box-breadcrumb.pug
include ../mixins/product-item.pug

block head
  link(rel="stylesheet" href="/assets/css/search.css")

block main
  // Breadcrumb
  +box-breadcrumb(breadcrumb)
  // End Breadcrumb

  // Section 9 - Search Results
  .section-9.search-section
    .container
      .inner-wrap
        .inner-left
          // Box Filter
          .box-filter
            .inner-head
              .inner-title Tìm Kiếm & Bộ Lọc
              i.fa-solid.fa-filter
            .inner-body
              .inner-group
                .inner-label Từ khoá
                input.search-input(
                  style="width: 100%; border: 1px solid #ddd; border-radius: 6px; padding: 10px; outline: none; font-size: 14px; margin-bottom: 5px; color: #333;"
                  type="text" 
                  name="keyword" 
                  value=keyword 
                  placeholder="Nhập tên tour bạn muốn tìm..."
                )
              .inner-group
                .inner-label Điểm đi
                select(name="locationFrom")
                  option(value="") -- Chọn điểm đi --
                  each item in cityList
                    option(value=item.id) #{item.name}
              .inner-group
                .inner-label Điểm đến
                select(name="locationTo")
                  option(value="") -- Chọn điểm đến --
                  each item in destinationList
                    option(value=item) #{item}
              .inner-group
                .inner-label Ngày khởi hành
                input(type="date" name="departureDate")
              .inner-group
                .inner-label Số Lượng Hành Khách
                .inner-input-list
                  .inner-input-item
                    .inner-label Người lớn:
                    input(
                      value="0" 
                      min="0"
                      type="number"
                      name="stockAdult"
                      )
                  .inner-input-item
                    .inner-label Trẻ em:
                    input(
                      value="0" 
                      min="0"
                      type="number"
                      name="stockChildren"
                      )
                  .inner-input-item
                    .inner-label Em bé:
                    input(
                      value="0" 
                      min="0"
                      type="number"
                      name="stockBaby"
                      )
              .inner-group
                .inner-label Mức giá
                select(name="price")
                  option(value="") -- Chọn khoảng giá --
                  option(value="0-999999") Dưới 1tr
                  option(value="1000000-3000000") Từ 1tr đến 3tr
                  option(value="3000000-6000000") Từ 3tr đến 6tr
                  option(value="6000000-10000000") Từ 6tr đến 10tr
                  option(value="10000000-1000000000") Trên 10tr
              .inner-group
                button.inner-button Áp Dụng
          .inner-overlay
          // End Box Filter
        .inner-right
          .inner-info.search-header
            if keyword
              h2.inner-title Kết quả tìm kiếm cho: 
                span.text-highlight "#{keyword}"
            else
              h2.inner-title Khám phá tất cả các Tour
            .inner-desc
              | Chúng tôi tìm thấy <b>#{totalTour}</b> tour phù hợp với yêu cầu của bạn.
          
          .inner-info-2
            .inner-sort
              .inner-label Sắp xếp:
              .inner-list
                button(sort-key="priceNewAdult" sort-value="asc")
                  | Giá tăng dần
                  i.fa-solid.fa-square-caret-up
                button(sort-key="priceNewAdult" sort-value="desc")
                  | Giá giảm dần
                  i.fa-solid.fa-square-caret-down
                button(sort-key="discount" sort-value="desc")
                  | Khuyến Mại Hot
                  i.fa-solid.fa-tag
            .inner-count-record
              | Tất cả: 
              b #{totalTour} Tour
            button.inner-filter-mobile
              span.inner-title Bộ Lọc
              i.fa-solid.fa-filter

          .inner-list-tour
            if (tourList && tourList.length > 0)
              each item in tourList
                +product-item(item)
            else 
              .empty-search
                .empty-icon
                  i.fa-solid.fa-magnifying-glass-location
                h3 Rất tiếc, không tìm thấy tour nào!
                p Có vẻ như chúng tôi không có tour nào khớp với từ khoá 
                  if keyword
                    b "#{keyword}"
                  |  của bạn.
                p Hãy thử thay đổi từ khoá hoặc xoá bộ lọc.
                a.btn-back-home(href="/") Quay lại trang chủ

          // Pagination
          if totalPages > 1
            .box-pagination
              if page > 1
                button(onclick=`const u = new URL(window.location.href); u.searchParams.set('page', ${page - 1}); window.location.href = u.href;`)
                  i.fa-solid.fa-angles-left
              - for(let i = 1; i <= totalPages; i++)
                button(class=(i == page ? "active" : "") onclick=`const u = new URL(window.location.href); u.searchParams.set('page', ${i}); window.location.href = u.href;`) #{i}
              if page < totalPages
                button(onclick=`const u = new URL(window.location.href); u.searchParams.set('page', ${page + 1}); window.location.href = u.href;`)
                  i.fa-solid.fa-angles-right
          // End Pagination


