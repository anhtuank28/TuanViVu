  // Section 4
  .section-4
    .container
      h2.box-title(
        data-aos-duration="800" 
        data-aos="fade-up"
        ) Tour Trong Nước
      .inner-wrap(
        data-aos-delay="150" 
        data-aos-duration="800" 
        data-aos="fade-up"
        )
        each item in tourListSection4
          // Product Item
          +product-item(item)
          // End Product Item
      .inner-button
        a.button-outline(href="#") Xem tất cả
  // End Section 4


  // Section 6
  .section-6
    .container
      h2.box-title(
        data-aos-duration="800" 
        data-aos="fade-up"
        ) Tour Nước Ngoài
      .inner-wrap(
        data-aos-delay="150" 
        data-aos-duration="800" 
        data-aos="fade-up"
        )
        each item in tourListSection5
          // Product Item
          +product-item(item)
          // End Product Item
      .inner-button
        a.button-outline(href="#") Xem tất cả
