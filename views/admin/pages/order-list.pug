extends ../layouts/default.pug

block main
  h1.box-title Quản lý đơn hàng

  form(action="" method="GET" id="form-filter")
    //- Section 4
    .section-4
      .inner-wrap
        .inner-item.inner-label
          <i class="fa-solid fa-filter"></i> Bộ lọc
        .inner-item
          select(name="status" onchange="this.form.submit()")
            option(value="") Trạng thái
            option(value="initial" selected=(query.status == "initial")) Khởi tạo
            option(value="done" selected=(query.status == "done")) Hoàn thành
            option(value="cancel" selected=(query.status == "cancel")) Hủy
        .inner-item.inner-date
          input(type="date" name="fromDate" value=query.fromDate onchange="this.form.submit()")
          span -
          input(type="date" name="toDate" value=query.toDate onchange="this.form.submit()")
        .inner-item
          select(name="paymentMethod" onchange="this.form.submit()")
            option(value="") Phương thức thanh toán
            option(value="money" selected=(query.paymentMethod == "money")) Tiền mặt
            option(value="momo" selected=(query.paymentMethod == "momo")) Ví Momo
            option(value="bank" selected=(query.paymentMethod == "bank")) Chuyển khoản
        .inner-item
          select(name="paymentStatus" onchange="this.form.submit()")
            option(value="") Trạng thái thanh toán
            option(value="paid" selected=(query.paymentStatus == "paid")) Đã thanh toán
            option(value="unpaid" selected=(query.paymentStatus == "unpaid")) Chưa thanh toán
        .inner-item.inner-reset(onclick="window.location.href=window.location.pathname" style="cursor: pointer;")
          <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
    //- End Section 4

    //- Section 5
    .section-5
      .inner-wrap
        .inner-search
          <i class="fa-solid fa-magnifying-glass"></i>
          input(type="text" name="keyword" placeholder="Tìm kiếm" value=query.keyword onchange="this.form.submit()")
    //- End Section 5

  //- Section 6
  .section-6
    .table-2
      table
        thead
          tr
            th Mã
            th Thông tin khách
            th Danh sách tour
            th Thanh toán
            th Trạng thái
            th(class="inner-center") Ngày đặt
            if (permissions.includes('order-edit') || permissions.includes('order-delete'))
              th Hành động
        tbody
          each orderDetail in orderList
            tr
              td
                .inner-code #{orderDetail.orderCode}
              td
                div Họ tên: #{orderDetail.fullName}
                div SĐT: #{orderDetail.phone}
                div Ghi chú: #{orderDetail.note}
              td
                each item in orderDetail.items
                  .inner-item
                    .inner-image
                      img(src=item.avatar, alt=item.name)
                    .inner-content
                      .inner-name #{item.name}
                      .inner-quantity Người lớn: #{item.quantityAdult} x #{(item.priceNewAdult || 0).toLocaleString("vi-VN")}đ
                      .inner-quantity Trẻ em: #{item.quantityChildren} x #{(item.priceNewChildren || 0).toLocaleString("vi-VN")}đ
                      .inner-quantity Em bé: #{item.quantityBaby} x #{(item.priceNewBaby || 0).toLocaleString("vi-VN")}đ
              td
                div Tổng tiền: <b style="color: red;">#{(orderDetail.total || 0).toLocaleString("vi-VN")}đ</b>
                div Thanh toán: <b>#{orderDetail.paymentMethodName}</b>
                if (orderDetail.paymentStatus == "paid")
                  div Trạng thái: <b style="color: green;">#{orderDetail.paymentStatusName}</b>
                else
                  div Trạng thái: <b style="color: orange;">#{orderDetail.paymentStatusName}</b>
              td
                if (orderDetail.status == "initial")
                  .badge.badge-orange #{orderDetail.statusName}
                else if (orderDetail.status == "done")
                  .badge.badge-green #{orderDetail.statusName}
                else if (orderDetail.status == "cancel")
                  .badge.badge-red #{orderDetail.statusName}
              td(class="inner-center")
                div #{orderDetail.createdAtTime}
                div #{orderDetail.createdAtDate}
              if (permissions.includes('order-edit') || permissions.includes('order-delete'))
                td
                  .inner-buttons
                    if(permissions.includes('order-edit'))
                      a(
                        href=`/${pathAdmin}/order/edit/${orderDetail.id}`
                        class="inner-edit"
                      ) <i class="fa-regular fa-pen-to-square"></i>
                    if(permissions.includes('order-delete'))
                      button(class="inner-delete") <i class="fa-regular fa-trash-can"></i>
  //- End Section 6

  //- Section 7
  if (pagination)
    .section-7
      span(class="inner-label") Hiển thị #{orderList.length>0 ? pagination.skip + 1 :0} - #{pagination.skip + orderList.length} của #{pagination.totalRecord}
      select(class="inner-pagination" pagination)
        - for (let i = 1; i <= pagination.totalPage; i++)
          option(value=i selected=(i == pagination.currentPage ? true : false)) Trang #{i}
  //- End Section 7