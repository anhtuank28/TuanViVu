extends ../layouts/default.pug

block main
  h1.box-title Nhóm quyền

  //- Section 5
  .section-5
    .inner-wrap
      if(permissions.includes('role-delete'))
        .inner-change-status(change-multi data-api=`/${pathAdmin}/setting/role/change-multi`)
          .inner-item
            select
              option(value="") -- Hành động --
              option(value="delete") Xóa
          .inner-item
            button Áp dụng
      .inner-search
        <i class="fa-solid fa-magnifying-glass"></i>
        input(type="text" placeholder="Tìm kiếm" search)
      if(permissions.includes('role-create'))
        .inner-button-create
          a(href=`/${pathAdmin}/setting/role/create`) + Tạo mới
      if(permissions.includes('role-delete'))
        .inner-button-trash
          a(href=`/${pathAdmin}/setting/role/trash`) Thùng rác
  //- End Section 5

  //- Section 6
  .section-6
    .table-2
      table
        thead
          tr
            th(class="inner-center")
              input(type="checkbox" class="inner-check" check-all)
            th Tên nhóm quyền
            th Mô tả ngắn
            if(permissions.includes('role-edit') || permissions.includes('role-delete'))
              th Hành động
        tbody
          each item in roleList
            tr
              td(class="inner-center")
                input(type="checkbox" class="inner-check" check-item=item.id)
              td #{item.name}
              td #{item.description}
              if(permissions.includes('role-edit') || permissions.includes('role-delete'))
                td
                  .inner-buttons
                    if(permissions.includes('role-edit'))
                      a(
                        href=`/${pathAdmin}/setting/role/edit/${item.id}`
                        class="inner-edit"
                      ) <i class="fa-regular fa-pen-to-square"></i>
                    if(permissions.includes('role-delete'))
                      button(
                        class="inner-delete"
                        button-delete
                        data-api=`/${pathAdmin}/setting/role/delete/${item.id}`
                      ) <i class="fa-regular fa-trash-can"></i>
  //- End Section 6