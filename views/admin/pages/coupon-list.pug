extends ../layouts/default.pug

block main
    h1.box-title Quản lý mã giảm giá

    //- Section 5
    .section-5
      .inner-wrap
        .inner-search
          <i class="fa-solid fa-magnifying-glass"></i>
          input(type="text" placeholder="Tìm kiếm" search)
        .inner-button-create
            a(href=`/${pathAdmin}/coupon/create`) + Tạo mới
    //- End Section 5

    //- Section 6
    .section-6
      .table-2
        table
          thead
            tr
              th(class="inner-center")
                input(type="checkbox" class="inner-check" check-all)
              th Mã Coupon
              th Loại
              th Giá trị
              th(class="inner-center") Lượt dùng còn
              th(class="inner-center") Trạng thái
              th Hạn sử dụng
              th Hành động
          
          tbody
            each item in coupons
              tr
                td(class="inner-center")
                  input(type="checkbox" class="inner-check" check-item=item.id)
                td #{item.code}
                td #{item.type == 'percent' ? 'Phần trăm' : 'Số tiền'}
                td #{item.type == 'percent' ? item.value + '%' : item.value.toLocaleString("vi-VN") + 'đ'}
                td(class="inner-center") #{item.quantity}
                td(class="inner-center")
                  if(item.status == "active")
                    .badge.badge-green Hoạt động
                  else
                    .badge.badge-red Tạm dừng
                td 
                  if(item.expireAt)
                    span #{new Date(item.expireAt).toLocaleDateString("vi-VN")}
                  else
                    span Không giới hạn
                td
                  .inner-buttons
                    a(
                      href=`/${pathAdmin}/coupon/edit/${item.id}`
                      class="inner-edit"
                    ) <i class="fa-regular fa-pen-to-square"></i>
                    button(
                      class="inner-delete"
                      button-delete
                      data-api=`/${pathAdmin}/coupon/delete/${item.id}`
                    ) <i class="fa-regular fa-trash-can"></i>
    //- End Section 6
